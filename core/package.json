{
  "name": "sql-analyst-academy",
  "description": "Offline-first SQL learning platform with interactive analytics challenges, Web Worker execution, and interview practice.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build --mode production",
    "build:check": "vite build --mode development",
    "build:esbuild": "node esbuild.mjs",
    "build:prod": "npm run typecheck && vite build --mode production && npm run compress",
    "compress": "node precompress.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npx tsx testRunner.ts",
    "test:e2e": "playwright test",
    "audit:dead-code": "knip --reporter compact --no-exit-code",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --quiet",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@preact/preset-vite": "^2.10.6",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.9",
    "monaco-editor": "^0.52.2",
    "preact": "^10.29.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.0",
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "puppeteer": "^25.6.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
